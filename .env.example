# ──────────────────────────────────────────────────────────────
#  boilerplate-ecom-telebot · environment configuration
#  Copy to `.env` and fill in your secrets.
# ──────────────────────────────────────────────────────────────

# ── bot ───────────────────────────────────────────────────────
BOT_TOKEN=                    # from @BotFather
LOG_LEVEL=INFO
LANGUAGE=id                   # default user language; one of: id, en, ru

# ── shop ──────────────────────────────────────────────────────
CURRENCY=IDR                  # ISO 4217. Default: IDR. Telegram sends amounts in smallest units (1 IDR = 1 unit)
SHOP_NAME="Toko Saya"
SHOP_SUPPORT_USERNAME=support  # shown in receipts and /help
SHOP_CHANNEL_USERNAME=        # optional: where to send broadcast audience

# ── payments ──────────────────────────────────────────────────
# provider_token: required for IDR/RUB/USD with Telegram Payments API.
#   Get one from a supported Telegram payment partner (Tranzzo, Stripe ID, YooKassa, etc.).
#   See https://core.telegram.org/bots/payments
# stars: optional, enable alongside provider_token if you also accept Telegram Stars.
PAYMENT_PROVIDERS=provider_token
PROVIDER_TOKEN=

# ── admins (comma-separated telegram user ids) ────────────────
ADMINS=                       # e.g. 123456789,987654321

# ── database ──────────────────────────────────────────────────
# production:
DATABASE_URL=postgresql+psycopg://bot:bot@postgres:5432/bot
# local dev alternative:
# DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# ── redis (fsm storage + cart cache) ──────────────────────────
# production:
REDIS_URL=redis://redis:6379/0
# local dev alternative:
# REDIS_URL=

# ── deployment mode ───────────────────────────────────────────
USE_WEBHOOK=False
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET_TOKEN=         # any random string; protects webhook endpoint
HOST=0.0.0.0
PORT=8000
POLLING_TIMEOUT=30

# ── order TTL (minutes): how long an AWAITING_PAYMENT order is reserved ─
ORDER_RESERVATION_TTL=15
